# ============================================
# Environment Variables Template untuk SA Portal
# ============================================
# Copy file ini ke .env dan isi dengan nilai yang sesuai
# cp .env.example .env

# Database
POSTGRES_USER=sa_portal
POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_DB=sa_portal_db

# Backend
DATABASE_URL=postgresql+asyncpg://sa_portal:your-secure-password-here@db:5432/sa_portal_db
# Opsional: server Postgres UJI untuk `pytest -m integration` (lihat backend/README.md).
# Jangan arahkan ke database dev/Compose; fixture membuat & menghapus database sa_test_<hex> sendiri.
# TEST_DATABASE_URL=postgresql+asyncpg://postgres:test@127.0.0.1:55432/postgres
# JWT signing key — WAJIB di-set (tidak ada default). Pakai string acak min 32 char.
JWT_SECRET_KEY=your-random-secret-key-32-chars-minimum
# Environment runtime: development / staging / production.
# production memblok demo mode secara hard (app refuse-to-start jika DEMO_MODE=true).
ENVIRONMENT=development
# Jumlah proxy tepercaya di depan backend yang MENAMBAH entri X-Forwarded-For (rate limiter
# memakai IP klien = entri ke-N dari kanan). 0 = abaikan XFF (aman, tapi semua anonim di balik
# proxy berbagi satu kuota). Cara menentukan & memverifikasi N: deployment.md.
TRUSTED_PROXY_HOPS=0
# Registry image (default: docker.io; contoh lain: ghcr.io) dan owner/namespace-nya
# IMAGE_REGISTRY=docker.io
# IMAGE_OWNER=nikkisatmaka
# Tag image untuk compose.yaml (produksi), terpisah per komponen. Pin ke semver, hindari latest.
# BACKEND_IMAGE_TAG=latest
# FRONTEND_IMAGE_TAG=latest
# Demo mode (bypass OAuth). Default false; hanya aktif saat ENVIRONMENT bukan production.
DEMO_MODE=false
FRONTEND_URL=https://sa-portal.mov.co.id
# CORS allow-list origin dipisah koma. Untuk dev lokal gunakan http://localhost:3000.
# Jangan pakai "*" karena allow_credentials=True (kombinasi invalid/insecure).
CORS_ORIGINS=https://sa-portal.mov.co.id
GOOGLE_REDIRECT_URI=https://sa-portal.mov.co.id/api/v1/auth/callback
ALLOWED_DOMAINS=mov.co.id
# JSON email/wildcard -> role fungsional (Sales, Product, SA, Lead_SA). Hanya berlaku saat
# user dibuat (login pertama); user yang sudah ada diubah lewat endpoint admin.
# Nilai peran harus persis salah satu dari Sales, Product, SA, Lead_SA (huruf besar-kecil
# dihitung). Peran lain (mis. "Superuser", "admin", dan "Admin": admin bukan role lagi, lihat
# ADMIN_EMAILS) membuat backend menolak start; jika lolos, entri itu diabaikan dengan
# peringatan di log dan user baru jadi SA.
ROLE_MAPPING='{"admin-awal@mov.co.id": "SA"}'
# Email (dipisah koma, tanpa wildcard) yang menjadi admin (flag is_admin) saat login pertama.
# Admin menempel pada satu role fungsional dari ROLE_MAPPING. WAJIB isi minimal satu admin awal
# di produksi; setelah itu admin lain diatur lewat endpoint admin.
ADMIN_EMAILS=admin-awal@mov.co.id

# LLM
LLM_PROVIDER=gemini
LLM_MODEL_NAME=gemini-3.8-flash      # ID model Gemini; cek daftar model terbaru di dokumentasi Google AI
GEMINI_API_KEY=your-gemini-api-key-here

# Guardrails LLM — batas & toggle lapisan keamanan pemanggilan LLM
LLM_MAX_INPUT_CHARS=20000          # batas karakter input teks (truncate, bukan reject)
LLM_MAX_SOURCE_CHARS=60000          # anggaran karakter total sumber (kuesioner + Source document) untuk generate Requirement
LLM_MAX_DOCUMENT_BYTES=10485760    # 10 MB batas byte dokumen multimodal
GUARDRAIL_PII_DETECTION_ENABLED=true  # aktifkan deteksi PII (flag-and-log saja)

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# Gmail (opsional) — untuk pengiriman email notifikasi via Gmail API.
# Kosongkan untuk melewati email (graceful fallback); in-app notification tetap jalan.
# GMAIL_CREDENTIALS: JSON service account key (satu baris). Butuh domain-wide
# delegation + GMAIL_SENDER bila mengirim atas nama user domain.
GMAIL_CREDENTIALS=
GMAIL_SENDER=

# Google Drive (opsional) — provisioning folder proyek otomatis saat SA di-assign.
# GDRIVE_SERVICE_ACCOUNT_KEY: JSON key service account dalam SATU baris, dibuat di
# Google Cloud Console (IAM & Admin → Service Accounts → Keys). Kunci PRODUKSI harus
# kunci TERPISAH dari kunci uji (verifikasi live memakai kunci sendiri). JANGAN di-commit.
# Dibiarkan kosong: provisioning folder berstatus `failed` secara graceful (tidak crash);
# proyek tetap bisa di-assign dan folder dapat di-provision ulang setelah kunci diisi.
GDRIVE_SERVICE_ACCOUNT_KEY=

# Frontend
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
BACKEND_URL=http://backend:8000
